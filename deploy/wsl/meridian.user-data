#cloud-config
# meridian: Ubuntu 26.04 LTS on WSL2. This file is the distro's definition.
#
# Before installing, copy it to  %USERPROFILE%\.cloud-init\meridian.user-data  then:
#   wsl --install Ubuntu-26.04 --name meridian --location Z:\WSL\meridian --vhd-size 200GB --no-launch
#   wsl -d meridian -u root -- cloud-init status --wait --long     (first boot; must exit 0)
#   wsl --terminate meridian                                        (so /etc/wsl.conf applies)
#   wsl --set-default meridian
# Versions, checksums and the pages they were read from: UPSTREAM.md.

users:
  # Owner. First regular user, so uid 1000. Passwordless sudo is the owner's choice.
  - name: apoth
    gecos: Owner
    groups: [adm, dialout, cdrom, floppy, sudo, audio, dip, video, plugdev, netdev]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
  # Service user for the trading nodes. No login, no sudo, no home.
  - name: paper
    gecos: Paper trading service user
    system: true
    shell: /usr/sbin/nologin
    lock_passwd: true
    homedir: /nonexistent
    no_create_home: true

# New York time, set here and not inherited from Windows (see [time] below), so the
# shell, the logs and the engine agree with US market hours wherever the host clock points.
timezone: America/New_York

write_files:
  # Whole file, not appended: one definition, no duplicate sections.
  - path: /etc/wsl.conf
    permissions: "0644"
    content: |
      [boot]
      systemd=true

      [user]
      default=apoth

      [interop]
      appendWindowsPath=false

      [time]
      useWindowsTimezone=false
  # Claude Code, machine-wide: no claude.ai connectors, whichever user or config home
  # starts it (a terminal, or a tool that launches it with its own profile).
  - path: /etc/claude-code/managed-settings.json
    permissions: "0644"
    content: |
      {
        "disableClaudeAiConnectors": true
      }
  # Claude Code, machine-wide: no MCP server at all. This file takes exclusive control of MCP,
  # so no server starts from a project's .mcp.json, the user's config, a plugin or --mcp-config.
  # An evidence record that adds a server adds it here.
  - path: /etc/claude-code/managed-mcp.json
    permissions: "0644"
    content: |
      {
        "mcpServers": {}
      }
  # Codex CLI, machine-wide (ADR 0018): ChatGPT apps off in every config layer, and a named MCP
  # allowlist: a server starts only when its name and identity both match. On a running distro,
  # deploy/wsl/setup.sh codex-requirements writes this same text.
  - path: /etc/codex/requirements.toml
    permissions: "0644"
    content: |
      [features]
      apps = false

      [mcp_servers.openaiDeveloperDocs.identity]
      url = "https://developers.openai.com/mcp"

      [mcp_servers.serena.identity]
      command = "serena"

package_update: true
# Bring the image's packages up to date on first boot.
package_upgrade: true
# apt's default applies: recommended packages are installed too (the Gateway libraries bring
# about 67 packages that way, a terminal emulator among them). git and curl are in the image.
# No gh here: Ubuntu's (2.46.0) is inside two high advisories; `setup.sh gh` installs GitHub's.
packages:
  - git
  - build-essential
  - curl
  - jq
  - unzip
  # Libraries the IB Gateway window needs (it shows on the Windows desktop through WSLg).
  # IBKR publishes no package list; this one is from the docs of the browser component the
  # Gateway embeds. See UPSTREAM.md.
  - libgtk-3-0t64
  - libnss3
  - libnspr4
  - libasound2t64
  - libatk1.0-0t64
  - libatk-bridge2.0-0t64
  - libatspi2.0-0t64
  - libcups2t64
  - xdg-utils

runcmd:
  # Node.js: exact version, checksum from the release's SHASUMS256.txt.
  - |
    set -eu
    NODE_VERSION=v24.22.3
    NODE_SHA256=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
    NODE_TARBALL="node-${NODE_VERSION}-linux-x64.tar.xz"
    curl -fsSLo "/var/tmp/${NODE_TARBALL}" "https://nodejs.org/dist/${NODE_VERSION}/${NODE_TARBALL}"
    echo "${NODE_SHA256}  /var/tmp/${NODE_TARBALL}" | sha256sum -c -
    install -d "/opt/node-${NODE_VERSION}"
    tar -xJf "/var/tmp/${NODE_TARBALL}" -C "/opt/node-${NODE_VERSION}" --strip-components=1
    for bin in node npm npx; do
      ln -sf "/opt/node-${NODE_VERSION}/bin/${bin}" "/usr/local/bin/${bin}"
    done
    rm -f "/var/tmp/${NODE_TARBALL}"
  # The same setting in the owner's own Claude Code settings.
  - |
    set -eu
    install -d -o apoth -g apoth -m 0700 /home/apoth/.claude
    printf '{\n  "disableClaudeAiConnectors": true\n}\n' > /home/apoth/.claude/settings.json
    chown apoth:apoth /home/apoth/.claude/settings.json
    chmod 0644 /home/apoth/.claude/settings.json
  # Ubuntu Pro for WSL's bridge (wsl-pro.service, in the image) looks for the Ubuntu Pro agent
  # on Windows, which is not installed here. Left on, it retries for about ten minutes, exits,
  # and is started again 20 minutes later, for as long as the distro runs. Switched off; if that
  # agent is ever installed, `systemctl enable --now wsl-pro.service` brings it back. An image
  # without the unit is already in that state, so only a unit that is there is switched off.
  - |
    if systemctl cat wsl-pro.service >/dev/null 2>&1; then
      systemctl disable --now wsl-pro.service
    fi
  # Ubuntu Insights (Ubuntu's opt-in telemetry): "no", recorded the way Ubuntu's own
  # /usr/lib/wsl/ubuntu-insights.sh records it, so a first shell does not ask (its default is yes).
  # Its two user timers are also switched off for every user (the image enables them by preset).
  - |
    set -eu
    for source in linux wsl_setup ubuntu_release_upgrader; do
      su apoth -c 'ubuntu-insights consent "$0" -s=false >/dev/null' -- "${source}"
    done
    systemctl --global disable ubuntu-insights-collect.timer ubuntu-insights-upload.timer
  # The owner's user services (the Orca server that `setup.sh orca` installs) start at boot
  # without a login session. WSL still stops the distro about 15 s after its last WSL session
  # ends (instanceIdleTimeout in %USERPROFILE%\.wslconfig): see UPSTREAM.md.
  - loginctl enable-linger apoth
