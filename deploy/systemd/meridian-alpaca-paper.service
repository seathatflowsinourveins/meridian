# Meridian: the Alpaca paper lane under the `paper` service user. PREPARED, NOT ENABLED.
#
# Nothing installs this file and it has no [Install] section, so it cannot be enabled by
# accident. Milestone M7 (unattended running) installs it, after the owner's attended first
# Alpaca paper order. Until the lane's entry point exists, it runs only the offline credential
# check (`python -m meridian.alpaca.credentials`), which opens no socket and prints no value.
#
# The paper keys reach the process only as systemd credentials (systemd.exec(5), systemd 259):
# the two encrypted files named below, which the owner creates with systemd-creds as described
# in docs/m3-alpaca.md ("Keys"). With an absolute path a missing file is fatal and the unit
# does not start; the lane also refuses without them. This file holds no key, no key-shaped
# value and no endpoint: the paper endpoint is hard-coded in meridian/alpaca/constants.py.
#
# /opt/meridian is a release checkout with its own interpreter, readable by `paper` (whose
# account has no home). M7 creates it; it does not exist yet.

[Unit]
Description=Meridian Alpaca paper lane (paper account only; prepared, not enabled)
Documentation=https://github.com/seathatflowsinourveins/meridian/blob/main/docs/m3-alpaca.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=paper
Group=paper
WorkingDirectory=/opt/meridian
LoadCredentialEncrypted=alpaca-paper-key-id:/etc/credstore.encrypted/alpaca-paper-key-id
LoadCredentialEncrypted=alpaca-paper-secret-key:/etc/credstore.encrypted/alpaca-paper-secret-key
ExecStart=/opt/meridian/.venv/bin/python -m meridian.alpaca.credentials
Restart=no
UMask=0077
# Hardening, systemd.exec(5): the lane needs outbound TCP to the paper host and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
