# Reconcile only, before the order run and after the close; no [Install]: the owner enables it.
[Unit]
Description=Meridian Alpaca paper lane: unattended restart (reconcile only)

[Timer]
OnCalendar=Mon..Fri 09:45 America/New_York
OnCalendar=Mon..Fri 16:15 America/New_York
Unit=meridian-alpaca-paper@restart.service
