# Order runs in the real-time sessions only: regular (IEX) and overnight (next trade date).
# Pre/after-hours quotes are delayed SIP (15 min). No [Install]: the owner's session enables it.
[Unit]
Description=Meridian Alpaca paper lane: unattended order runs, regular and overnight

[Timer]
OnCalendar=Mon..Fri 10:00 America/New_York
OnCalendar=Sun,Mon..Thu 22:00 America/New_York
Unit=meridian-alpaca-paper@order.service
